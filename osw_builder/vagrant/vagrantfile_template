Vagrant.configure("2") do |config|
    config.vm.box = "{box_name}"
    # change name "default" in libvirt to the box name
    config.vm.define "{box_name}"

    efi_boot = ENV['EFI_BOOT'] == 'true'
    hack_nonexistent = ENV['HACK_NONEXISTENT_LOADER'] == 'true'
    q35_chipset = ENV['Q35_CHIPSET'] == 'true'

    # Disable SSH key insertion for consistent authentication
    config.ssh.insert_key = false

    # ubuntu 20.04 takes 4min to boot (initramfs unpacking extremely slow, TODO)
    config.vm.boot_timeout = 600

    config.vm.provider :libvirt do |libvirt|
        libvirt.uri = "qemu:///session"
        libvirt.cpus = 4
        libvirt.cputopology :sockets => '1', :cores => '2', :threads => '2'
        # better mouse pointer
        libvirt.graphics_type = "spice"
        # remove prefix (tmp directory)
        libvirt.default_prefix = ""
        
        # Q35 chipset configuration
        if q35_chipset
            libvirt.disk_bus = "sata"
            libvirt.machine_type = "q35"
        end
        
        if hack_nonexistent
            libvirt.loader = "/nonexistent"  # For domain definition
        elsif efi_boot
            libvirt.loader = "/usr/share/OVMF/OVMF_CODE.fd"  # For EFI boot
        end
    end
end
